void CommonDataSubscriber::depthImageCallback(const sensor_msgs::ImageConstPtr& msg)
{
    // 将接收到的深度图像消息存储在 depth_image_msg_ 中
    depth_image_msg_ = msg;
}
void CommonDataSubscriber::scan2dCallback1(const sensor_msgs::LaserScan::ConstPtr& scan_msg)
{
    // Check if there are any subscribers for the depth image topic
    if (imageDepthSub_.getNumPublishers() > 0) {
        // Get the current depth image
        
		sensor_msgs::ImagePtr depth_image = depth_image_msg_; 
        int depth_image_width = depth_image->width;
		int depth_image_height = depth_image->height;
        // Assuming that the scan data corresponds to the ground level of the image
        int ground_row = depth_image->height - 1;  // Example: Last row of the image
        int scan_size = scan_msg->ranges.size();
        float max_depth_value = 0.0f;
        // Calculate the effective number of scan points to map to depth image width
        int effective_scan_size = std::min(scan_size, depth_image_width);
      int depth_image_width = depth_image->width;
        int depth_image_height = depth_image->height;
        int ground_row = depth_image_height - 1;  // 例子: 最后一行表示地面
        int scan_size = scan_msg->ranges.size();

        // 获取最大深度值（根据图像的编码类型）
        float max_depth_distance = 0.0f;

        if (depth_image->encoding == "mono8") {
            // 对于 "mono8"，最大深度映射到 255
            max_depth_distance = 255.0f;
        } else if (depth_image->encoding == "32FC1") {
            // 对于 "32FC1"，可以遍历图像找到最大深度值
            for (int y = 0; y < depth_image_height; ++y) {
                for (int x = 0; x < depth_image_width; ++x) {
                    int pixel_index = y * depth_image_width + x;
                    float depth_value = *reinterpret_cast<float*>(&depth_image->data[pixel_index * sizeof(float)]);
                    if (depth_value > max_depth_distance) {
                        max_depth_distance = depth_value;
                    }
                }
            }
        } else if (depth_image->encoding == "rgb8") {
            // 对于 "rgb8"，根据颜色推算最大深度
            for (int y = 0; y < depth_image_height; ++y) {
                for (int x = 0; x < depth_image_width; ++x) {
                    int pixel_index = (y * depth_image_width + x) * 3; // 3个颜色通道
                    uint8_t r = depth_image->data[pixel_index];
                    uint8_t g = depth_image->data[pixel_index + 1];
                    uint8_t b = depth_image->data[pixel_index + 2];
                    // 通过某种映射方式转换 RGB 到深度，这里简单使用亮度（可以按实际需求调整）
                    float depth_value = (r + g + b) / 3.0f;
                    if (depth_value > max_depth_distance) {
                        max_depth_distance = depth_value;
                    }
                }
            }
        }

        // 设置最大深度值
        ROS_INFO("Maximum depth distance in this frame: %f", max_depth_distance);

        // 计算有效的扫描点数量，映射到深度图像宽度
        int effective_scan_size = std::min(scan_size, depth_image_width);

        for (int i = 0; i < effective_scan_size; ++i) {
            float range = scan_msg->ranges[i];
            if (std::isfinite(range) && range < max_depth_distance) {
                int pixel_x = i;
                int pixel_y = ground_row;
                
                if (depth_image->encoding == "mono8") {
                    uint8_t depth_value = static_cast<uint8_t>((range / max_depth_distance) * 255);
                    depth_image->data[pixel_y * depth_image_width + pixel_x] = depth_value;
                } else if (depth_image->encoding == "32FC1") {
                    int pixel_index = pixel_y * depth_image_width + pixel_x;
                    float depth_value = range;
                    memcpy(&depth_image->data[pixel_index * sizeof(float)], &depth_value, sizeof(float));
                } else if (depth_image->encoding == "rgb8") {
                    int pixel_index = (pixel_y * depth_image_width + pixel_x) * 3;
                    uint8_t color_value = static_cast<uint8_t>((range / max_depth_distance) * 255);
                    depth_image->data[pixel_index] = color_value;
                    depth_image->data[pixel_index + 1] = color_value;
                    depth_image->data[pixel_index + 2] = color_value;
                }
            }
        }

        // 发布修改后的深度图像
        modifiedDepthImagePublisher.publish(depth_image);
    }
}

